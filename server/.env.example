# Server port
PORT=5000

# Production MongoDB URI. When left empty the server uses a local MongoDB
# (mongodb://127.0.0.1:27017/nutrix) and falls back to an in-memory MongoDB.
MONGO_URI=

# JWT secret (required in production)
JWT_SECRET=change-me-to-a-long-random-string

# CORS origin for the client (dev uses Vite proxy, this matters for direct calls)
CLIENT_ORIGIN=http://localhost:5173

# Optional Cloudinary credentials — enables cloud image/video storage.
# Without these, uploads are stored locally in server/uploads.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
